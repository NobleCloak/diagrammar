      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@noblecloak/diagrammar-core": "^0.1.1",
    "hono": "4.13.7",
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tsdown": "0.23.0",
    "@types/node": "^24.0.0"
  }
}
