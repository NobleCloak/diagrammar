{
  "name": "@noblecloak/diagrammar-mcp",
  "version": "0.1.1",
  "description": "Streamable HTTP MCP server for Diagrammar diagrams.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/NobleCloak/diagrammar#readme",
  "bugs": "https://github.com/NobleCloak/diagrammar/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NobleCloak/diagrammar.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "diagram",
    "mcp",
    "model-context-protocol",
    "agent",
    "diagram-as-code"
  ],
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
