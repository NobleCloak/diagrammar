{
  "name": "@noblecloak/diagrammar-core",
  "version": "0.2.0",
  "description": "Parse, validate, edit, and render Diagrammar YAML diagrams to SVG/PNG/Markdown.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/NobleCloak/diagrammar#readme",
  "bugs": "https://github.com/NobleCloak/diagrammar/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NobleCloak/diagrammar.git",
    "directory": "packages/core"
  },
  "keywords": [
    "diagram",
    "d2",
    "svg",
    "png",
    "yaml",
    "diagram-as-code"
  ],
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "fonts",
    "schema",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "schema:generate": "bun scripts/generate-schema.ts"
  },
  "dependencies": {
    "zod": "4.6.2",
    "yaml": "2.9.1",
    "@d2lang/d2": "0.1.34",
    "@resvg/resvg-wasm": "2.6.2",
    "opentype.js": "2.0.0"
  },
  "devDependencies": {
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "@types/node": "^24.0.0"
  }
}
