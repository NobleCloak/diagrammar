{
  "name": "@noblecloak/diagrammar-icons-simple-icons",
  "version": "0.1.1",
  "description": "Simple Icons brand set for Diagrammar (`icon: simple-icons/<slug>`). No Amazon/AWS marks — use the AWS importer for those.",
  "type": "module",
  "license": "CC0-1.0",
  "homepage": "https://github.com/NobleCloak/diagrammar#readme",
  "bugs": "https://github.com/NobleCloak/diagrammar/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NobleCloak/diagrammar.git",
    "directory": "packages/icons-simple-icons"
  },
  "keywords": [
    "diagram",
    "icons",
    "simple-icons",
    "brands",
    "diagram-as-code"
  ],
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "icons.json.gz",
    "index.json",
    "LICENSE",
    "README.md",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "generate": "bun run ../../scripts/build-icon-set.ts simple-icons",
    "build": "bun run generate && tsdown",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@noblecloak/diagrammar-core": "^0.3.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tsdown": "0.23.0",
    "@types/node": "^24.0.0"
  }
}
