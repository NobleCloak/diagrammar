{
  "name": "diagrammar-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "build": "bun run --cwd packages/core build && bun run --cwd packages/icons-lucide build && bun run --cwd packages/icons-simple-icons build && bun run --cwd packages/mcp build && bun run --cwd packages/cli build",
    "schema:generate": "bun run --cwd packages/core schema:generate",
    "goldens:update": "bun run scripts/goldens-update.ts",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@eslint/js": "^10.0.1",
    "@noblecloak/diagrammar-core": "workspace:*",
    "@noblecloak/diagrammar-icons-lucide": "workspace:*",
    "@noblecloak/diagrammar-icons-simple-icons": "workspace:*",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "lucide-static": "1.46.0",
    "prettier": "3.9.6",
    "simple-icons": "16.31.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
